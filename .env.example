PORT=3001
FIREBASE_PROJECT_ID=code-js-514422
FIRESTORE_DATABASE_ID=blokio-puzzle-db

# Opcional: solo clientes web. La app móvil no necesita CORS.
CORS_ORIGIN=http://localhost:4200

# ID de paquete Android; debe coincidir con applicationId y con el de Play.
ANDROID_PACKAGE_NAME=com.codejs.blokio_puzzle

# En local: ruta al JSON de la cuenta de servicio.
# En Cloud Run NO se define: se usa la cuenta de servicio del servicio.
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json

# Correo usado por el formulario de soporte.
# EMAIL_USER=
# EMAIL_PASS=
